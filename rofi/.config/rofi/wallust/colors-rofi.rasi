background-color: #000202;
background: rgba(0,0,0,0.7);
foreground: #B2E3B4;
border-color: #107A62;

color0: #000202;
color1: #083F08;
color2: #35325A;
color3: #38325F;
color4: #0C5C4A;
color5: #2C5299;
color6: #1B841F;
color7: #89CF8C;
color8: #609162;

 /* wallust template - colors-rofi */

* {
active-background: #107A62;
active-foreground: #B2E3B4;
normal-background: #000202;
normal-foreground: #B2E3B4;
urgent-background: #3B6ECC;
urgent-foreground: #B2E3B4;

alternate-active-background: #4B427F;
alternate-active-foreground: #B2E3B4;
alternate-normal-background: #000202;
alternate-normal-foreground: #B2E3B4;
alternate-urgent-background: #000202;
alternate-urgent-foreground: #B2E3B4;

selected-active-background: #3B6ECC;
selected-active-foreground: #B2E3B4;
selected-normal-background: #3B6ECC;
selected-normal-foreground: #B2E3B4;
selected-urgent-background: #107A62;
